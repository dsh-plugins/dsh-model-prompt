{
  "name": "@dsh-plugin/dsh-model-prompt",
  "version": "0.1.0",
  "description": "按当前模型匹配提示词文件，向系统提示词注入模型专用指导，并在模型切换时替换头部",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-model-prompt.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-model-prompt",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-model-prompt/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "chokidar": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0-0"
  }
}
